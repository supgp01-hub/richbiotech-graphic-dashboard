rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }
    function isSupervisor() {
      return signedIn() && request.auth.token.email == 'supgp01@richbiotech.com';
    }
    function isImage() {
      return request.resource != null
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
    match /order-assets/{uid}/{allPaths=**} {
      allow read: if signedIn();
      allow create, update: if (request.auth.uid == uid || isSupervisor()) && isImage();
      allow delete: if request.auth.uid == uid || isSupervisor();
    }
    match /idcards/{uid}/{allPaths=**} {
      allow read: if signedIn();
      allow create, update: if (request.auth.uid == uid || isSupervisor()) && isImage();
      allow delete: if request.auth.uid == uid || isSupervisor();
    }
  }
}
